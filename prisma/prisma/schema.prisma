// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//vai ser os cliente que quiserem usar as compras online
model Cliente {
  id    String     @id @default(uuid()) @map("_id")
  email String     @unique
  name  String?    //na compra da loja tem que pelo menos ter um email 
  cartao Cartao?   //opcional 
  carrinho Carrrinho[]
}

//Cartão do cliente de mastercard , nu bank e entre outros 
model Cartao{
  id        String @id @default(uuid()) @map("_id") 
  name      String 
  clienteId String @unique  //cada cliente tem um cartão único
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}

//Produtos oferecidos até o momento
model Produto {
  id          String     @id @default(uuid()) @map("_id") 
  nome        String
  descricao   String?   //se quiser pode ter uma descrição 
  preco       Float
  estoque     Int
  empregado Empregado[] //produto pode ser alterados por vários empregados
  carrinhos Carrrinho[] //produtos estão em vários Carrinho
}

//Carrrinho do cliente com lista de produtos
model Carrrinho {
  id        String     @id @default(uuid())  @map("_id")
  clienteId String
  produtos  Produto[]   //carrinho podem ter vários produtos 
  trasacao Transacao[]  //o produto pode ter tido trasações feitas pelo cliente 
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}

//Empregado que pode mudar os itens da loja 
model Empregado {
  id        String     @id @default(uuid())
  name      String  @unique     //senha e name único para cada empregado
  senha     Int     @unique     //para poder mexer em produtos
  produtosModificados Produto[] //Ele mudou algo? então sera anotado
}

//Etapa final da compra que vai registrar o que eh gasto e data do ocorrido
model Transacao {
  id          String     @id @default(uuid())
  valor       Float
  data        DateTime
  clienteId   String
  produtos    Carrrinho
  cliente     Cliente @relation(fields: [clienteId], references: [id])
}


