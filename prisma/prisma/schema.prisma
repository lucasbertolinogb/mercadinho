// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"

}

//vai ser os cliente que quiserem usar as compras online
model Cliente {
  id    String     @id @default(uuid()) @map("_id")
  email String     @unique
  name  String?    //na compra da loja tem que pelo menos ter um email 
  cartao Cartao?   //opcional 
  carrinho Carrinho[]
  transacoes Transacao[]
}

//Cartão do cliente de mastercard , nu bank e entre outros 
model Cartao{
  id        String @id @default(uuid()) @map("_id") 
  name      String 
  numero    String
  validade  String
  cvv       String
  clienteId String @unique  //cada cliente tem um cartão único
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

//Produtos oferecidos até o momento
model Produto {
  id          String     @id @default(uuid()) @map("_id") 
  nome        String
  descricao   String?   //se quiser pode ter uma descrição 
  preco       Float
  estoque     Int
  imagem      String?
  categoria   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  carrinhoItens CarrinhoItem[] //produtos estão em vários itens de carrinho
}

//Carrinho do cliente com lista de produtos
model Carrinho {
  id        String     @id @default(uuid())  @map("_id")
  clienteId String
  itens     CarrinhoItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// Item do carrinho
model CarrinhoItem {
  id         String   @id @default(uuid()) @map("_id")
  quantidade Int
  preco      Float    // Preço no momento da adição
  produtoId  String
  carrinhoId String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  carrinho   Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
}

//Empregado que pode mudar os itens da loja 
model Empregado {
  id        String     @id @default(uuid())
  name      String  @unique     //senha e name único para cada empregado
  senha     String     @unique     //para poder mexer em produtos
  createdAt DateTime   @default(now())
}

//Etapa final da compra que vai registrar o que eh gasto e data do ocorrido
model Transacao {
  id          String     @id @default(uuid()) @map("_id")
  valor       Float
  data        DateTime   @default(now())
  clienteId   String
  status      String     @default("pendente")
  itens       String     // JSON dos itens comprados
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}


