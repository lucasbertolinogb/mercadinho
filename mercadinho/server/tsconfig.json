{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/app.ts",
    "src/auth.ts",
    "src/prisma.ts",
    "src/routes.ts",
    "src/server.ts",
    "src/controllers/**/*.ts"
  ]
}
